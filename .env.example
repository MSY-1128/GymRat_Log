# 실제 .env는 커밋 금지. 이 파일을 .env로 복사한 뒤 값을 교체하세요.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# --- PostgreSQL 컨테이너 (compose.yaml 의 env_file 로 주입) ---
POSTGRES_DB=fitlog
POSTGRES_USER=fitlog
POSTGRES_PASSWORD=replace_me
# 호스트에 공개할 포트(127.0.0.1 전용). 다른 PostgreSQL이 5432를 쓰는 경우가 많아 5433 기본.
POSTGRES_PORT=5433

# --- Spring Boot 백엔드 (scripts/run-backend.* 가 읽어 환경변수로 주입) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/fitlog
SPRING_DATASOURCE_USERNAME=fitlog
SPRING_DATASOURCE_PASSWORD=replace_me
# demo: data.json 샘플 음식/운동을 빈 DB에 1회 seed. 원치 않으면 비워 두세요.
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080

# --- 식약처 식품영양성분DB (data.go.kr 'FoodNtrCpntDbInfo03') ---
# 활용신청 후 받은 "Decoding" 키를 그대로 넣으세요(Encoding 키는 이중 인코딩되어 오류).
# 비워 두면 식약처 DB 검색만 비활성화되고 나머지 기능은 그대로 동작합니다.
MFDS_SERVICE_KEY=

# Spring Boot는 .env를 자동으로 읽지 않습니다.
# 백엔드는 scripts/run-backend.ps1 (Windows) 또는 scripts/run-backend.sh 로 실행하면
# 이 파일의 값이 명시적으로 주입됩니다.
